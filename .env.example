# ============================================================
# PaperReader · Docker 部署环境变量模板
# 用法：复制本文件为 .env（仓库根目录），填入真实值后 docker compose up -d --build
# 注意：.env 含真实密钥，永远不要提交到 Git！
# ============================================================

# ---- 必填 ----
POSTGRES_PASSWORD=change-me-a-strong-password
JWT_SECRET=change-me-a-random-long-string
LLM_API_KEY=your-deepseek-api-key
EMBEDDING_API_KEY=your-dashscope-api-key

# ---- 可选（有合理默认值）----
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# ---- 端口冲突时改这里 ----
# POSTGRES_PORT=15432
# REDIS_PORT=16379
# BACKEND_PORT=18000
# FRONTEND_PORT=8080
