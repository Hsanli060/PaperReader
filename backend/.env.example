# ============================================================
# PaperReader 环境变量模板
# 使用方法：复制本文件为 .env（cp .env.example .env），然后填入真实值
# 注意：.env 含真实密钥，永远不要提交到 Git！
# ============================================================

# ---- LLM（DeepSeek）----
LLM_API_KEY=your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ---- 向量（阿里云百炼 / 兼容 OpenAI 格式的服务）----
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# ---- 数据库（本地开发直连本机 PostgreSQL；Docker 部署用根目录 .env + docker-compose.yml）----
DATABASE_URL=postgresql+psycopg2://paperreader:paperreader@localhost:5432/paperreader

# ---- 可选：Redis 缓存（暂不使用可留空）----
REDIS_URL=

# ---- 用户级 API Key（批①：默认严格模式=false）----
# 设 true：用户没配自己的 key 时回退用上面的默认 key（本地开发方便；部署服务器保持默认/不设）
#ALLOW_DEFAULT_KEY=true
